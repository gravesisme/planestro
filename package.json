{
  "name": "planestro",
  "version": "1.0.1",
  "private": true,
  "license": "MIT",
  "description": "Local-first backlog planning and orchestration with Claude Code or Codex",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gravesisme/planestro.git"
  },
  "homepage": "https://github.com/gravesisme/planestro#readme",
  "bugs": {
    "url": "https://github.com/gravesisme/planestro/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "spike": "tsx spikes/sdk-spike.ts",
    "spike:codex": "tsx spikes/codex-spike.ts",
    "spike:codex-live": "tsx spikes/codex-live.ts",
    "planestro": "tsx packages/server/src/cli.ts",
    "test": "vitest run",
    "e2e": "playwright test",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p packages/web/tsconfig.json",
    "dev": "tsx watch packages/server/src/cli.ts serve",
    "dev:web": "npm --workspace packages/web run dev",
    "build": "npm --workspace packages/web run build",
    "start": "tsx packages/server/src/cli.ts serve",
    "sample": "tsx packages/server/src/cli.ts sample"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "^24.19.2",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.5",
    "zod": "^4.6.7"
  }
}
